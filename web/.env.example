# Supabase (publik; keamanan data dijaga lewat RLS, bukan dengan menyembunyikan key ini)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Minimal panjang password (bawaan 12, OWASP ASVS V2.1.1). Turunkan hanya untuk masa uji.
# NUXT_PUBLIC_PASSWORD_MIN_LENGTH=6

# true = daftar tanpa email verifikasi (akun dibuat lewat Admin API). Hanya untuk masa uji.
# NUXT_AUTH_SKIP_EMAIL_CONFIRM=true

# Kunci privat X25519 (base64, 32 byte) untuk enkripsi payload browser <-> server. Hanya server.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_TRANSPORT_PRIVATE_KEY=

# Hanya server (Nitro). Jangan diawali NUXT_PUBLIC_ dan jangan dipakai di client.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Koneksi Postgres langsung (Supabase pooler). Hanya server/migrasi, jangan pernah di client.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
