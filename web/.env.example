# Supabase (publik; keamanan data dijaga lewat RLS, bukan dengan menyembunyikan key ini)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Minimal panjang password (bawaan 12, OWASP ASVS V2.1.1). Turunkan hanya untuk masa uji.
# NUXT_PUBLIC_PASSWORD_MIN_LENGTH=6

# true = daftar tanpa email verifikasi (akun dibuat lewat Admin API). Hanya untuk masa uji.
# NUXT_AUTH_SKIP_EMAIL_CONFIRM=true

# Kunci privat X25519 (base64, 32 byte) untuk enkripsi payload browser <-> server. Hanya server.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NUXT_TRANSPORT_PRIVATE_KEY=

# Hanya server (Nitro). Jangan diawali NUXT_PUBLIC_ dan jangan dipakai di client.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Koneksi Postgres langsung (Supabase pooler). Hanya server/migrasi, jangan pernah di client.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Push notification FCM HTTP v1 (Firebase Service Account; hanya server)
# Isi JSON satu baris atau gunakan 3 variabel terpisah di bawahnya:
# NUXT_FCM_SERVICE_ACCOUNT_JSON=
# NUXT_FCM_PROJECT_ID=
# NUXT_FCM_CLIENT_EMAIL=
# NUXT_FCM_PRIVATE_KEY=

# Cron statistik harian (/api/cron/daily-stats). Wajib diisi: tanpa ini endpoint selalu 401.
# Isi juga secret repo GitHub CRON_SECRET dengan nilai yang sama.
# NUXT_CRON_SECRET=
# SMTP laporan harian (opsional)
# NUXT_SMTP_HOST=
# NUXT_SMTP_PORT=587
# NUXT_SMTP_USER=
# NUXT_SMTP_PASS=
# NUXT_SMTP_FROM=
# NUXT_SMTP_TARGET_EMAIL=

# Google Drive penyimpanan dokumen chat (OAuth akun penyimpanan; scope drive). Hanya server, jangan di-commit.
# NUXT_GDRIVE_CLIENT_ID=
# NUXT_GDRIVE_CLIENT_SECRET=
# NUXT_GDRIVE_REFRESH_TOKEN=

# Status online & "sedang mengetik..." (Supabase Realtime presence). Isi false untuk mematikan bila kuota Realtime habis.
# NUXT_PUBLIC_REALTIME_PRESENCE=true
