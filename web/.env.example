# =====================================================================================================
# seru24 web (Nuxt) — salin ke web/.env untuk lokal, dan isi variabel yang sama di Vercel
# (Project Settings → Environment Variables → Production). web/.env TIDAK ikut git.
#
# WAJIB    = aplikasi tidak jalan tanpa ini.
# OPSIONAL = fitur terkait mati dengan rapi bila dikosongkan (tidak membuat error).
# NUXT_PUBLIC_* ikut terkirim ke browser: jangan pernah isi rahasia di variabel berawalan NUXT_PUBLIC_.
# =====================================================================================================


# ---------------------------------------------------------------------------------------------------
# 1. Supabase — WAJIB
#    Supabase Dashboard → Project Settings → API.
# ---------------------------------------------------------------------------------------------------
# URL proyek, mis. https://abcdefghij.supabase.co (publik; data dijaga RLS + fungsi seru24_*)
NUXT_PUBLIC_SUPABASE_URL=
# anon / publishable key (publik)
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key — RAHASIA, hanya server (cron, dokumen, push). Jangan diawali NUXT_PUBLIC_.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Koneksi Postgres langsung (Dashboard → Connect → Session pooler). Hanya untuk menjalankan migrasi
# dari komputer sendiri; aplikasi tidak memakainya. Boleh dikosongkan di Vercel.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=


# ---------------------------------------------------------------------------------------------------
# 2. Enkripsi transport browser <-> server — WAJIB
#    Kunci privat X25519 (base64, 32 byte). Buat sekali, simpan; jangan diganti-ganti tanpa alasan.
#    node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------------------------------
NUXT_TRANSPORT_PRIVATE_KEY=


# ---------------------------------------------------------------------------------------------------
# 3. Pendaftaran & password — OPSIONAL (bawaan aman untuk produksi)
# ---------------------------------------------------------------------------------------------------
# Minimal panjang password (bawaan 12, OWASP ASVS V2.1.1). Turunkan hanya untuk masa uji.
# NUXT_PUBLIC_PASSWORD_MIN_LENGTH=12
# true = daftar tanpa email verifikasi (akun dibuat lewat Admin API). Hanya untuk masa uji / tanpa SMTP Supabase.
# NUXT_AUTH_SKIP_EMAIL_CONFIRM=false


# ---------------------------------------------------------------------------------------------------
# 4. Cron statistik + email laporan (Senin & Kamis 08.00 WIB) — OPSIONAL
#    Dipanggil GitHub Actions (.github/workflows/daily-stats-cron.yml) ke /api/cron/daily-stats:
#    rekap statistik, pangkas data tertua bila DB >= 400 MB, bersihkan dokumen yatim, lalu kirim email.
#
#    Belum siap SMTP? Isi NUXT_SMTP_ENABLED=false → cron tidak menjalankan apa pun.
# ---------------------------------------------------------------------------------------------------
NUXT_SMTP_ENABLED=true
# Rahasia acak untuk memanggil cron (tanpa ini endpoint selalu 401). Isi juga secret repo GitHub
# CRON_SECRET dengan nilai yang sama (+ secret SERU24_URL bila domain bukan seru24.vercel.app).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NUXT_CRON_SECRET=
# Tanggal mulai siklus tagihan Supabase tiap bulan (lihat dashboard Supabase > Usage). Dipakai email cron untuk
# menampilkan kapan kuota direset. Bawaan 11.
# NUXT_SUPABASE_BILLING_DAY=11
# Server SMTP pengirim laporan (Gmail: smtp.gmail.com port 587 + App Password, bukan password akun).
# Variabel tanpa awalan NUXT_ (SMTP_HOST, SMTP_PORT, ...) juga diterima.
# NUXT_SMTP_HOST=smtp.gmail.com
# NUXT_SMTP_PORT=587
# NUXT_SMTP_SECURE=false
# NUXT_SMTP_USER=
# NUXT_SMTP_PASS=
# NUXT_SMTP_FROM=
# Tujuan laporan; beberapa alamat dipisah koma. Kosong = dikirim ke NUXT_SMTP_USER.
# NUXT_SMTP_TARGET_EMAIL=


# ---------------------------------------------------------------------------------------------------
# 5. Google Drive (dokumen chat + rilis APK) — OPSIONAL
#    Tanpa ini: kirim dokumen menampilkan "Fitur dokumen belum dikonfigurasi", info APK terbaru kosong.
#    Butuh: Google Cloud project dengan Google Drive API aktif, OAuth Client, dan refresh token akun
#    penyimpanan (scope drive). Dokumen disimpan terenkripsi di folder seru24/<id percakapan>.
# ---------------------------------------------------------------------------------------------------
# NUXT_GDRIVE_CLIENT_ID=
# NUXT_GDRIVE_CLIENT_SECRET=
# NUXT_GDRIVE_REFRESH_TOKEN=


# ---------------------------------------------------------------------------------------------------
# 6. Push notification Android (Firebase Cloud Messaging HTTP v1) — OPSIONAL
#    Firebase Console → Project Settings → Service accounts → Generate new private key.
#    Isi JSON satu baris, ATAU tiga variabel terpisah. Tanpa ini, notifikasi HP saat aplikasi ditutup mati.
# ---------------------------------------------------------------------------------------------------
# NUXT_FCM_SERVICE_ACCOUNT_JSON=
# NUXT_FCM_PROJECT_ID=
# NUXT_FCM_CLIENT_EMAIL=
# NUXT_FCM_PRIVATE_KEY=


# ---------------------------------------------------------------------------------------------------
# 7. Status online & "sedang mengetik…" — OPSIONAL (bawaan aktif)
#    Memakai kuota pesan Supabase Realtime; isi false bila kuota tier gratis mulai habis.
# ---------------------------------------------------------------------------------------------------
NUXT_PUBLIC_REALTIME_PRESENCE=true
