# =====================================================================================================
# seru24 Android — salin ke mobile/.env. Dibaca scripts/gen-env.js menjadi src/env.ts saat build.
# SEMUA nilai di sini ikut masuk ke APK (bisa dibaca siapa pun yang membongkar APK):
# jangan pernah isi service_role key, password, atau rahasia lain di file ini.
# =====================================================================================================

# Supabase — WAJIB, sama dengan NUXT_PUBLIC_SUPABASE_URL / NUXT_PUBLIC_SUPABASE_ANON_KEY di web/.env
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Alamat server web (deploy Vercel) — WAJIB. Dipakai untuk login, dokumen, info rilis APK.
API_BASE_URL=https://seru24.vercel.app

# Minimal panjang password — OPSIONAL, samakan dengan NUXT_PUBLIC_PASSWORD_MIN_LENGTH (bawaan 12)
# PASSWORD_MIN_LENGTH=12

# Status online & "sedang mengetik…" — OPSIONAL, samakan dengan NUXT_PUBLIC_REALTIME_PRESENCE
REALTIME_PRESENCE=true
