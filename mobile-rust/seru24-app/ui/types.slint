export struct ChatItem {
    id: string,
    name: string,
    username: string,
    initials: string,
    avatar-color: color,
    preview: string,
    time: string,
    unread: int,
    pinned: bool,
    incoming-request: bool,
    blocked: bool,
}

export struct BubbleItem {
    key: string,
    server-id: string,
    seq: int,
    mine: bool,
    text: string,
    quote-who: string,
    reply-snippet: string,
    time: string,
    ticks: string,
    read: bool,
    revised: bool,
    deleted: bool,
    pending: bool,
    failed: string,
    is-file: bool,
    is-voice: bool,
    file-name: string,
    file-ext: string,
    file-size: string,
    progress: string,
    saved-path: string,
    day-label: string,
}

export struct FoundUserItem {
