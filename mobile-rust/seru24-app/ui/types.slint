    username: string,
    display-name: string,
}

export struct ScheduledItem {
    id: string,
    when-label: string,
    text: string,
    failed: bool,
}

export struct PinItem {
    key: string,
    time-label: string,
    snippet: string,
}

export struct SearchHitItem {
    key: string,
